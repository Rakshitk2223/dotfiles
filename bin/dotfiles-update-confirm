#!/bin/bash
# Show update information and ask for confirmation
# Returns 0 if user confirms, 1 if user cancels

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-$HOME/.local/bin/dotfiles}"

# Source state library
source "$REPO_ROOT/lib/state.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

show_help() {
    cat << EOF
Usage: dotfiles-update-confirm [OPTIONS]

Check for updates and show what would change.

Options:
    -h, --help      Show this help message
    -y, --yes       Skip confirmation prompt (for scripting)
    -q, --quiet     Only show if update is available (exit code)
    --check-only    Just check, don't prompt

Exit codes:
    0   Update available (and confirmed if prompted)
    1   No update available or user cancelled
EOF
}

# Fetch latest from remote without merging
fetch_remote() {
    git -C "$REPO_ROOT" fetch --quiet origin main 2>/dev/null || \
    git -C "$REPO_ROOT" fetch --quiet origin master 2>/dev/null || \
    git -C "$REPO_ROOT" fetch --quiet 2>/dev/null || true
}

# Get the main branch name
get_main_branch() {
    if git -C "$REPO_ROOT" show-ref --verify --quiet refs/heads/main; then
        echo "main"
    else
        echo "master"
    fi
}

# Get commit count between local and remote
get_commit_count() {
    local branch
    branch=$(get_main_branch)
    git -C "$REPO_ROOT" rev-list --count HEAD..origin/"$branch" 2>/dev/null || echo "0"
}

# Get list of changed files
get_changed_files() {
    local branch
    branch=$(get_main_branch)
    git -C "$REPO_ROOT" diff --name-only HEAD..origin/"$branch" 2>/dev/null || true
}

# Get commit messages since current HEAD
get_new_commits() {
    local branch
    branch=$(get_main_branch)
    git -C "$REPO_ROOT" log --oneline HEAD..origin/"$branch" 2>/dev/null || true
}

# Check for pending migrations
get_pending_migrations() {
    local migrations_dir="$REPO_ROOT/migrations"
    local count=0
    
    if [[ -d "$migrations_dir" ]]; then
        for migration in "$migrations_dir"/*.sh; do
            [[ -f "$migration" ]] || continue
            local name
            name=$(basename "$migration")
            if ! state_migration_done "$name"; then
                ((count++))
            fi
        done
    fi
    echo "$count"
}

# Show update summary
show_update_summary() {
    local current_version new_version commit_count
    
    current_version=$(state_get_version)
    
    # Get version from remote
    local branch
    branch=$(get_main_branch)
    new_version=$(git -C "$REPO_ROOT" show origin/"$branch":version 2>/dev/null || echo "unknown")
    
    commit_count=$(get_commit_count)
    
    echo -e "${BOLD}╔══════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}║         Dotfiles Update Available        ║${NC}"
    echo -e "${BOLD}╚══════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "  Current version:  ${YELLOW}$current_version${NC}"
    echo -e "  Available version: ${GREEN}$new_version${NC}"
    echo -e "  Commits behind:   ${CYAN}$commit_count${NC}"
    echo ""
    
    # Show new commits
    local commits
    commits=$(get_new_commits)
    if [[ -n "$commits" ]]; then
        echo -e "${BOLD}Recent changes:${NC}"
        echo "$commits" | head -10 | while read -r line; do
            echo -e "  ${BLUE}•${NC} $line"
        done
        local total
        total=$(echo "$commits" | wc -l)
        if [[ $total -gt 10 ]]; then
            echo -e "  ${BLUE}...${NC} and $((total - 10)) more commits"
        fi
        echo ""
    fi
    
    # Show changed files summary
    local changed_files
    changed_files=$(get_changed_files)
    if [[ -n "$changed_files" ]]; then
        local file_count
        file_count=$(echo "$changed_files" | wc -l)
        echo -e "${BOLD}Files to update:${NC} $file_count files"
        
        # Group by directory
        local config_count script_count other_count
        config_count=$(echo "$changed_files" | grep -c "^\.config/" || echo "0")
        script_count=$(echo "$changed_files" | grep -cE "^(bin/|scripts/)" || echo "0")
        other_count=$((file_count - config_count - script_count))
        
        [[ $config_count -gt 0 ]] && echo -e "  ${BLUE}•${NC} Config files: $config_count"
        [[ $script_count -gt 0 ]] && echo -e "  ${BLUE}•${NC} Scripts: $script_count"
        [[ $other_count -gt 0 ]] && echo -e "  ${BLUE}•${NC} Other: $other_count"
        echo ""
    fi
    
    # Show pending migrations
    local pending_migrations
    pending_migrations=$(get_pending_migrations)
    if [[ $pending_migrations -gt 0 ]]; then
        echo -e "${YELLOW}Pending migrations:${NC} $pending_migrations"
        echo ""
    fi
}

main() {
    local auto_yes=false
    local quiet=false
    local check_only=false
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -y|--yes)
                auto_yes=true
                shift
                ;;
            -q|--quiet)
                quiet=true
                shift
                ;;
            --check-only)
                check_only=true
                shift
                ;;
            *)
                echo "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done
    
    # Fetch latest
    if ! $quiet; then
        echo -e "${CYAN}Checking for updates...${NC}"
    fi
    fetch_remote
    
    # Check if updates available
    local commit_count
    commit_count=$(get_commit_count)
    
    if [[ "$commit_count" == "0" ]]; then
        if ! $quiet; then
            echo -e "${GREEN}✓${NC} Dotfiles are up to date ($(state_get_version))"
        fi
        exit 1
    fi
    
    # Quiet mode - just exit with code
    if $quiet; then
        exit 0
    fi
    
    # Show update summary
    echo ""
    show_update_summary
    
    # Check only mode
    if $check_only; then
        exit 0
    fi
    
    # Auto-yes mode
    if $auto_yes; then
        exit 0
    fi
    
    # Ask for confirmation
    echo -e "${BOLD}Proceed with update?${NC} [y/N] "
    read -r response
    
    if [[ "$response" =~ ^[Yy]$ ]]; then
        exit 0
    else
        echo -e "${YELLOW}Update cancelled${NC}"
        exit 1
    fi
}

main "$@"
