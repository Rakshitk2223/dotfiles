#!/bin/bash
# Refresh core config files from the dotfiles repository
# This script updates core configs while preserving local customizations

set -euo pipefail

# Get the repository root directory
REPO_ROOT="${REPO_ROOT:-$HOME/.local/bin/dotfiles}"
STATE_DIR="${STATE_DIR:-$HOME/.local/state/dotfiles}"
BACKUP_DIR="$STATE_DIR/backups/config"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_diff() {
    echo -e "${BLUE}[DIFF]${NC} $1"
}

show_help() {
    cat << EOF
Usage: dotfiles-refresh-config [OPTIONS] [CONFIG]

Refresh core configuration files from the dotfiles repository.
This updates core/ files while preserving your local/ customizations.

Options:
    -h, --help      Show this help message
    -l, --list      List available configs to refresh
    -d, --diff      Show diff before applying changes
    -f, --force     Apply changes without confirmation
    -b, --backup    Create backup even if no changes
    --dry-run       Show what would be done without making changes

Configs:
    hypr            Refresh Hyprland core configs
    waybar          Refresh Waybar config
    all             Refresh all configs (default)

Examples:
    dotfiles-refresh-config              # Refresh all configs
    dotfiles-refresh-config hypr         # Refresh only Hyprland
    dotfiles-refresh-config -d hypr      # Show diff first
    dotfiles-refresh-config --dry-run    # Preview changes
EOF
}

list_configs() {
    echo "Available configs to refresh:"
    echo ""
    echo "  hypr     - Hyprland configuration (~/.config/hypr/core/)"
    echo "             Files: appearance, autostart, environment, input,"
    echo "                    keybinds, layout, programs, windowrules"
    echo ""
    echo "  waybar   - Waybar configuration (~/.config/waybar/)"
    echo "             Files: config, style.css"
    echo ""
    echo "  all      - All of the above"
}

# Create a timestamped backup
create_backup() {
    local source_file="$1"
    local config_name="$2"
    
    if [[ ! -f "$source_file" ]]; then
        return 0
    fi
    
    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S)
    local backup_path="$BACKUP_DIR/$config_name/$timestamp"
    local relative_path="${source_file#$HOME/}"
    local backup_file="$backup_path/$relative_path"
    
    mkdir -p "$(dirname "$backup_file")"
    cp "$source_file" "$backup_file"
    
    echo "$backup_file"
}

# Show diff between two files
show_diff() {
    local old_file="$1"
    local new_file="$2"
    local name="$3"
    
    if [[ ! -f "$old_file" ]]; then
        log_diff "New file: $name"
        return 0
    fi
    
    if diff -q "$old_file" "$new_file" > /dev/null 2>&1; then
        return 1  # No changes
    fi
    
    log_diff "Changes in $name:"
    diff --color=auto -u "$old_file" "$new_file" 2>/dev/null || true
    echo ""
    return 0
}

# Refresh a single file
refresh_file() {
    local source="$1"
    local dest="$2"
    local config_name="$3"
    local show_diff_flag="$4"
    local force="$5"
    local dry_run="$6"
    local always_backup="$7"
    
    local filename
    filename=$(basename "$source")
    
    if [[ ! -f "$source" ]]; then
        log_warn "Source file not found: $source"
        return 1
    fi
    
    # Check if destination exists and compare
    local has_changes=false
    if [[ -f "$dest" ]]; then
        if ! diff -q "$source" "$dest" > /dev/null 2>&1; then
            has_changes=true
        fi
    else
        has_changes=true
    fi
    
    if [[ "$has_changes" == "false" ]]; then
        if [[ "$always_backup" == "true" ]]; then
            create_backup "$dest" "$config_name" > /dev/null
        fi
        return 0  # No changes needed
    fi
    
    # Show diff if requested
    if [[ "$show_diff_flag" == "true" && -f "$dest" ]]; then
        show_diff "$dest" "$source" "$filename"
    fi
    
    # Dry run - just report
    if [[ "$dry_run" == "true" ]]; then
        log_info "[DRY RUN] Would update: $dest"
        return 0
    fi
    
    # Confirm unless forced
    if [[ "$force" != "true" && -f "$dest" ]]; then
        echo -n "Update $filename? [y/N] "
        read -r response
        if [[ ! "$response" =~ ^[Yy]$ ]]; then
            log_info "Skipped: $filename"
            return 0
        fi
    fi
    
    # Create backup before overwriting
    if [[ -f "$dest" ]]; then
        local backup_file
        backup_file=$(create_backup "$dest" "$config_name")
        if [[ -n "$backup_file" ]]; then
            log_info "Backed up to: $backup_file"
        fi
    fi
    
    # Copy new file
    mkdir -p "$(dirname "$dest")"
    cp "$source" "$dest"
    log_info "Updated: $dest"
    
    return 0
}

# Refresh Hyprland core configs
refresh_hypr() {
    local show_diff="$1"
    local force="$2"
    local dry_run="$3"
    local always_backup="$4"
    
    local source_dir="$REPO_ROOT/.config/hypr/core"
    local dest_dir="$HOME/.config/hypr/core"
    
    log_info "Refreshing Hyprland core configs..."
    
    if [[ ! -d "$source_dir" ]]; then
        log_error "Hyprland core directory not found in repo: $source_dir"
        return 1
    fi
    
    mkdir -p "$dest_dir"
    
    local updated=0
    for source_file in "$source_dir"/*.conf; do
        [[ -f "$source_file" ]] || continue
        local filename
        filename=$(basename "$source_file")
        local dest_file="$dest_dir/$filename"
        
        if refresh_file "$source_file" "$dest_file" "hypr" "$show_diff" "$force" "$dry_run" "$always_backup"; then
            ((updated++)) || true
        fi
    done
    
    # Also refresh hyprland.conf itself
    local main_source="$REPO_ROOT/.config/hypr/hyprland.conf"
    local main_dest="$HOME/.config/hypr/hyprland.conf"
    if [[ -f "$main_source" ]]; then
        refresh_file "$main_source" "$main_dest" "hypr" "$show_diff" "$force" "$dry_run" "$always_backup"
    fi
    
    log_info "Hyprland refresh complete"
    
    # Remind about local overrides
    echo ""
    log_info "To customize, create files in ~/.config/hypr/local/"
    log_info "Local files override core settings and are never touched by updates"
}

# Refresh Waybar config
refresh_waybar() {
    local show_diff="$1"
    local force="$2"
    local dry_run="$3"
    local always_backup="$4"
    
    local source_dir="$REPO_ROOT/.config/waybar"
    local dest_dir="$HOME/.config/waybar"
    
    log_info "Refreshing Waybar config..."
    
    if [[ ! -d "$source_dir" ]]; then
        log_error "Waybar directory not found in repo: $source_dir"
        return 1
    fi
    
    mkdir -p "$dest_dir"
    
    # Refresh main config files
    for file in config style.css; do
        local source_file="$source_dir/$file"
        local dest_file="$dest_dir/$file"
        
        if [[ -f "$source_file" ]]; then
            refresh_file "$source_file" "$dest_file" "waybar" "$show_diff" "$force" "$dry_run" "$always_backup"
        fi
    done
    
    # Refresh scripts
    if [[ -d "$source_dir/scripts" ]]; then
        mkdir -p "$dest_dir/scripts"
        for script in "$source_dir/scripts"/*.sh; do
            [[ -f "$script" ]] || continue
            local filename
            filename=$(basename "$script")
            refresh_file "$script" "$dest_dir/scripts/$filename" "waybar" "$show_diff" "$force" "$dry_run" "$always_backup"
        done
    fi
    
    log_info "Waybar refresh complete"
}

main() {
    local show_diff=false
    local force=false
    local dry_run=false
    local always_backup=false
    local config="all"
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -l|--list)
                list_configs
                exit 0
                ;;
            -d|--diff)
                show_diff=true
                shift
                ;;
            -f|--force)
                force=true
                shift
                ;;
            -b|--backup)
                always_backup=true
                shift
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            hypr|waybar|all)
                config="$1"
                shift
                ;;
            *)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done
    
    # Ensure backup directory exists
    mkdir -p "$BACKUP_DIR"
    
    # Refresh requested configs
    case "$config" in
        hypr)
            refresh_hypr "$show_diff" "$force" "$dry_run" "$always_backup"
            ;;
        waybar)
            refresh_waybar "$show_diff" "$force" "$dry_run" "$always_backup"
            ;;
        all)
            refresh_hypr "$show_diff" "$force" "$dry_run" "$always_backup"
            echo ""
            refresh_waybar "$show_diff" "$force" "$dry_run" "$always_backup"
            ;;
    esac
    
    if [[ "$dry_run" == "true" ]]; then
        echo ""
        log_info "Dry run complete. No changes were made."
    fi
}

main "$@"
