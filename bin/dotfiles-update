#!/bin/bash
# Main dotfiles update orchestrator
# Coordinates: confirm -> backup -> git -> packages -> migrations -> configs -> hooks

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-$HOME/.local/bin/dotfiles}"
STATE_DIR="${STATE_DIR:-$HOME/.local/state/dotfiles}"

# Source libraries
source "$REPO_ROOT/lib/state.sh"
source "$REPO_ROOT/lib/hooks.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Step counter
CURRENT_STEP=0
TOTAL_STEPS=7

log_step() {
    ((CURRENT_STEP++)) || true
    echo ""
    echo -e "${BOLD}${CYAN}[$CURRENT_STEP/$TOTAL_STEPS]${NC} ${BOLD}$1${NC}"
}

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

show_help() {
    cat << EOF
Usage: dotfiles-update [OPTIONS]

Update dotfiles to the latest version.

This command will:
  1. Check for updates and show what's new
  2. Ask for confirmation
  3. Pull latest changes from git
  4. Install any new packages
  5. Run pending migrations
  6. Refresh config files
  7. Run post-update hooks

Options:
    -h, --help          Show this help message
    -y, --yes           Skip confirmation prompt
    --dry-run           Show what would be done without making changes
    --no-packages       Skip package installation
    --no-sync           Don't run system package sync (pacman -Syu)
    --force             Force update even with local changes
    --check             Just check for updates (don't update)

Examples:
    dotfiles-update              # Interactive update
    dotfiles-update -y           # Auto-confirm update
    dotfiles-update --dry-run    # Preview what would happen
    dotfiles-update --check      # Just check if updates available
EOF
}

# Show rollback instructions
show_rollback_info() {
    echo ""
    echo -e "${YELLOW}If something went wrong, you can rollback:${NC}"
    echo ""
    echo "  1. Git rollback:"
    echo "     cd $REPO_ROOT && git reflog"
    echo "     git reset --hard <commit>"
    echo ""
    echo "  2. Config backups are in:"
    echo "     $STATE_DIR/backups/"
    echo ""
    echo "  3. Re-run installation:"
    echo "     $REPO_ROOT/scripts/install_dotfiles.sh"
}

# Run a step and handle errors
run_step() {
    local description="$1"
    shift
    local command=("$@")
    
    if ! "${command[@]}"; then
        log_error "$description failed"
        return 1
    fi
    return 0
}

main() {
    local auto_yes=false
    local dry_run=false
    local skip_packages=false
    local skip_sync=true  # Default: don't run full sync
    local force=false
    local check_only=false
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -y|--yes)
                auto_yes=true
                shift
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --no-packages)
                skip_packages=true
                shift
                ;;
            --no-sync)
                skip_sync=true
                shift
                ;;
            --sync)
                skip_sync=false
                shift
                ;;
            --force)
                force=true
                shift
                ;;
            --check)
                check_only=true
                shift
                ;;
            *)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done
    
    # Header
    echo ""
    echo -e "${BOLD}╔════════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}║            Dotfiles Update                 ║${NC}"
    echo -e "${BOLD}╚════════════════════════════════════════════╝${NC}"
    
    # Check only mode
    if $check_only; then
        "$REPO_ROOT/bin/dotfiles-update-confirm" --check-only
        exit $?
    fi
    
    # =========================================================================
    # Step 1: Check for updates and confirm
    # =========================================================================
    log_step "Checking for updates..."
    
    local confirm_args=()
    $auto_yes && confirm_args+=(--yes)
    
    if ! "$REPO_ROOT/bin/dotfiles-update-confirm" "${confirm_args[@]}"; then
        log_info "No updates available or update cancelled"
        exit 0
    fi
    
    # Dry run notice
    if $dry_run; then
        echo ""
        echo -e "${YELLOW}═══ DRY RUN MODE - No changes will be made ═══${NC}"
        echo ""
    fi
    
    # =========================================================================
    # Step 2: Run pre-update hook
    # =========================================================================
    log_step "Running pre-update hooks..."
    
    if ! $dry_run; then
        hook_run pre-update || log_warn "Pre-update hook failed (continuing)"
    else
        log_info "[DRY RUN] Would run pre-update hook"
    fi
    
    # =========================================================================
    # Step 3: Pull git changes
    # =========================================================================
    log_step "Pulling latest changes..."
    
    local git_args=()
    $dry_run && git_args+=(--dry-run)
    $force && git_args+=(--force)
    
    if ! "$REPO_ROOT/bin/dotfiles-update-git" "${git_args[@]}"; then
        local exit_code=$?
        if [[ $exit_code -eq 2 ]]; then
            log_info "Already up to date"
        else
            log_error "Git update failed"
            show_rollback_info
            exit 1
        fi
    fi
    
    # =========================================================================
    # Step 4: Run migrations
    # =========================================================================
    log_step "Running migrations..."
    
    if ! $dry_run; then
        if ! migrations_run_all; then
            log_error "Migration failed"
            show_rollback_info
            exit 1
        fi
    else
        log_info "[DRY RUN] Would run pending migrations"
        # Show pending migrations
        local pending
        pending=$(migrations_get_pending)
        if [[ -n "$pending" ]]; then
            echo "$pending" | while read -r m; do
                [[ -n "$m" ]] && log_info "  Would run: $(basename "$m")"
            done
        fi
    fi
    
    # =========================================================================
    # Step 5: Install packages
    # =========================================================================
    log_step "Checking packages..."
    
    if $skip_packages; then
        log_info "Package installation skipped (--no-packages)"
    else
        local pkg_args=()
        $dry_run && pkg_args+=(--dry-run)
        ! $skip_sync && pkg_args+=(--sync)
        
        "$REPO_ROOT/bin/dotfiles-update-packages" "${pkg_args[@]}" || {
            log_warn "Package installation had issues (non-critical)"
        }
    fi
    
    # =========================================================================
    # Step 6: Refresh configs
    # =========================================================================
    log_step "Refreshing configurations..."
    
    local refresh_args=(--force)
    $dry_run && refresh_args+=(--dry-run)
    
    "$REPO_ROOT/bin/dotfiles-refresh-config" "${refresh_args[@]}" hypr || {
        log_warn "Config refresh had issues (non-critical)"
    }
    
    # =========================================================================
    # Step 7: Ensure hardware configs exist
    # =========================================================================
    log_step "Ensuring hardware configs..."
    
    local hw_args=()
    $dry_run && hw_args+=(--dry-run)
    
    if ! "$REPO_ROOT/bin/dotfiles-ensure-hardware-configs" "${hw_args[@]}"; then
        log_warn "Hardware config generation had issues (non-critical)"
    fi
    
    # =========================================================================
    # Post-update
    # =========================================================================
    echo ""
    log_step "Finishing up..."
    
    if ! $dry_run; then
        # Record update state
        state_record_update
        log_info "Update state recorded"
        
        # Run post-update hook
        hook_run post-update || log_warn "Post-update hook failed (non-critical)"
    fi
    
    # =========================================================================
    # Done!
    # =========================================================================
    echo ""
    if $dry_run; then
        echo -e "${YELLOW}═══ DRY RUN COMPLETE - No changes were made ═══${NC}"
    else
        echo -e "${GREEN}╔════════════════════════════════════════════╗${NC}"
        echo -e "${GREEN}║            Update Complete!                ║${NC}"
        echo -e "${GREEN}╚════════════════════════════════════════════╝${NC}"
        echo ""
        log_success "Dotfiles updated to version $(state_get_version)"
        echo ""
        echo -e "${CYAN}Recommended:${NC}"
        echo "  • Reload Hyprland config: ${BOLD}hyprctl reload${NC}"
        echo "  • Or restart Hyprland:    ${BOLD}Super+Shift+M${NC}"
        echo ""
        echo -e "${CYAN}If you have issues:${NC}"
        echo "  • Check logs:    journalctl --user -xe"
        echo "  • Rollback:      cd $REPO_ROOT && git reflog"
    fi
    
    exit 0
}

main "$@"
