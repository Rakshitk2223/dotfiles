#!/bin/bash
# Main dotfiles update orchestrator
# Coordinates: git pull -> migrations -> packages -> sync -> hooks
#
# IMPORTANT: This script ALWAYS syncs files to the system, even if git
# reports "already up to date". This ensures that manual git pulls or
# any other situation where repo is updated but files aren't synced
# will still result in properly updated system files.

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-$HOME/.local/bin/dotfiles}"
STATE_DIR="${STATE_DIR:-$HOME/.local/state/dotfiles}"

# Source libraries
source "$REPO_ROOT/lib/state.sh"
source "$REPO_ROOT/lib/hooks.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Step counter
CURRENT_STEP=0
TOTAL_STEPS=6

log_step() {
    ((CURRENT_STEP++)) || true
    echo ""
    echo -e "${BOLD}${CYAN}[$CURRENT_STEP/$TOTAL_STEPS]${NC} ${BOLD}$1${NC}"
}

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

show_help() {
    cat << EOF
Usage: dotfiles-update [OPTIONS]

Update dotfiles to the latest version.

This command will:
  1. Check for git updates and pull if available
  2. Run pre-update hooks
  3. Run pending migrations
  4. Check for new packages
  5. Sync all config files to system
  6. Run post-update hooks

Options:
    -h, --help          Show this help message
    -y, --yes           Skip confirmation prompt
    --dry-run           Show what would be done without making changes
    --no-packages       Skip package installation
    --no-sync           Don't run system package sync (pacman -Syu)
    --force             Force git pull even with local changes
    --check             Just check for updates (don't update)
    --sync-only         Skip git pull, just sync files to system

Examples:
    dotfiles-update              # Full update with confirmation
    dotfiles-update -y           # Auto-confirm update
    dotfiles-update --dry-run    # Preview what would happen
    dotfiles-update --check      # Just check if updates available
    dotfiles-update --sync-only  # Just sync files (no git pull)
EOF
}

show_rollback_info() {
    echo ""
    echo -e "${YELLOW}If something went wrong, you can rollback:${NC}"
    echo ""
    echo "  1. Git rollback:"
    echo "     cd $REPO_ROOT && git reflog"
    echo "     git reset --hard <commit>"
    echo ""
    echo "  2. Config backups are in:"
    echo "     $STATE_DIR/backups/"
    echo ""
    echo "  3. Re-run sync:"
    echo "     dotfiles-sync"
}

# Check if there are remote updates available
check_for_updates() {
    git -C "$REPO_ROOT" fetch --quiet origin 2>/dev/null || true
    
    local branch
    if git -C "$REPO_ROOT" show-ref --verify --quiet refs/heads/main; then
        branch="main"
    else
        branch="master"
    fi
    
    local local_commit remote_commit
    local_commit=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo "unknown")
    remote_commit=$(git -C "$REPO_ROOT" rev-parse origin/"$branch" 2>/dev/null || echo "unknown")
    
    if [[ "$local_commit" != "$remote_commit" ]]; then
        local commit_count
        commit_count=$(git -C "$REPO_ROOT" rev-list --count HEAD..origin/"$branch" 2>/dev/null || echo "0")
        echo "$commit_count"
    else
        echo "0"
    fi
}

# Show update summary
show_update_summary() {
    local commit_count="$1"
    
    local branch
    if git -C "$REPO_ROOT" show-ref --verify --quiet refs/heads/main; then
        branch="main"
    else
        branch="master"
    fi
    
    local current_version new_version
    current_version=$(state_get_version 2>/dev/null || echo "unknown")
    new_version=$(git -C "$REPO_ROOT" show origin/"$branch":version 2>/dev/null || echo "unknown")
    
    echo ""
    echo -e "${BOLD}╔══════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}║         Dotfiles Update Available        ║${NC}"
    echo -e "${BOLD}╚══════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "  Current version:  ${YELLOW}$current_version${NC}"
    echo -e "  Available version: ${GREEN}$new_version${NC}"
    echo -e "  Commits behind:   ${CYAN}$commit_count${NC}"
    echo ""
    
    # Show recent commits
    local commits
    commits=$(git -C "$REPO_ROOT" log --oneline HEAD..origin/"$branch" 2>/dev/null | head -5 || true)
    if [[ -n "$commits" ]]; then
        echo -e "${BOLD}Recent changes:${NC}"
        echo "$commits" | while read -r line; do
            echo -e "  ${BLUE}•${NC} $line"
        done
        echo ""
    fi
}

# Confirm with user
confirm_update() {
    local auto_yes="$1"
    
    if [[ "$auto_yes" == "true" ]]; then
        return 0
    fi
    
    echo -n -e "${BOLD}Proceed with update?${NC} [Y/n] "
    read -r response
    
    if [[ "$response" =~ ^[Nn]$ ]]; then
        return 1
    fi
    
    return 0
}

main() {
    local auto_yes=false
    local dry_run=false
    local skip_packages=false
    local skip_sync=true
    local force=false
    local check_only=false
    local sync_only=false
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -y|--yes)
                auto_yes=true
                shift
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --no-packages)
                skip_packages=true
                shift
                ;;
            --no-sync)
                skip_sync=true
                shift
                ;;
            --sync)
                skip_sync=false
                shift
                ;;
            --force)
                force=true
                shift
                ;;
            --check)
                check_only=true
                shift
                ;;
            --sync-only)
                sync_only=true
                shift
                ;;
            *)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done
    
    # Header
    echo ""
    echo -e "${BOLD}╔════════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}║            Dotfiles Update                 ║${NC}"
    echo -e "${BOLD}╚════════════════════════════════════════════╝${NC}"
    
    # Check only mode
    if $check_only; then
        echo ""
        log_info "Checking for updates..."
        local updates
        updates=$(check_for_updates)
        
        if [[ "$updates" == "0" ]]; then
            echo ""
            echo -e "${GREEN}✓${NC} Dotfiles are up to date"
            exit 0
        else
            show_update_summary "$updates"
            exit 0
        fi
    fi
    
    # Dry run notice
    if $dry_run; then
        echo ""
        echo -e "${YELLOW}═══ DRY RUN MODE - No changes will be made ═══${NC}"
    fi
    
    # =========================================================================
    # Step 1: Check for updates and pull from git
    # =========================================================================
    log_step "Checking for updates..."
    
    local has_git_updates=false
    
    if $sync_only; then
        log_info "Sync-only mode: skipping git pull"
    else
        local updates
        updates=$(check_for_updates)
        
        if [[ "$updates" != "0" ]]; then
            has_git_updates=true
            show_update_summary "$updates"
            
            if ! confirm_update "$auto_yes"; then
                log_info "Update cancelled"
                exit 0
            fi
            
            echo ""
            log_info "Pulling latest changes..."
            
            local git_args=()
            $dry_run && git_args+=(--dry-run)
            $force && git_args+=(--force)
            
            if ! "$REPO_ROOT/bin/dotfiles-update-git" "${git_args[@]}"; then
                local exit_code=$?
                if [[ $exit_code -ne 2 ]]; then
                    log_error "Git update failed"
                    show_rollback_info
                    exit 1
                fi
            fi
        else
            log_info "Git repository is up to date"
        fi
    fi
    
    # =========================================================================
    # Step 2: Run pre-update hooks
    # =========================================================================
    log_step "Running pre-update hooks..."
    
    if ! $dry_run; then
        hook_run pre-update || log_warn "Pre-update hook failed (continuing)"
    else
        log_info "[DRY RUN] Would run pre-update hooks"
    fi
    
    # =========================================================================
    # Step 3: Run migrations
    # =========================================================================
    log_step "Running migrations..."
    
    if ! $dry_run; then
        if ! migrations_run_all; then
            log_warn "Migration had issues (continuing)"
        fi
    else
        log_info "[DRY RUN] Would run pending migrations"
    fi
    
    # =========================================================================
    # Step 4: Install packages
    # =========================================================================
    log_step "Checking packages..."
    
    if $skip_packages; then
        log_info "Package installation skipped (--no-packages)"
    else
        local pkg_args=()
        $dry_run && pkg_args+=(--dry-run)
        ! $skip_sync && pkg_args+=(--sync)
        
        "$REPO_ROOT/bin/dotfiles-update-packages" "${pkg_args[@]}" 2>/dev/null || {
            log_warn "Package check had issues (non-critical)"
        }
    fi
    
    # =========================================================================
    # Step 5: Sync files to system (ALWAYS RUNS)
    # =========================================================================
    log_step "Syncing files to system..."
    
    local sync_args=()
    $dry_run && sync_args+=(--dry-run)
    
    if ! "$REPO_ROOT/bin/dotfiles-sync" "${sync_args[@]}"; then
        log_error "File sync failed"
        show_rollback_info
        exit 1
    fi
    
    # =========================================================================
    # Step 6: Post-update
    # =========================================================================
    log_step "Finishing up..."
    
    if ! $dry_run; then
        state_record_update
        log_info "Update state recorded"
        
        hook_run post-update || log_warn "Post-update hook failed (non-critical)"
    else
        log_info "[DRY RUN] Would record update state"
    fi
    
    # =========================================================================
    # Done!
    # =========================================================================
    echo ""
    if $dry_run; then
        echo -e "${YELLOW}═══ DRY RUN COMPLETE - No changes were made ═══${NC}"
    else
        echo -e "${GREEN}╔════════════════════════════════════════════╗${NC}"
        echo -e "${GREEN}║            Update Complete!                ║${NC}"
        echo -e "${GREEN}╚════════════════════════════════════════════╝${NC}"
        echo ""
        log_success "Dotfiles updated to version $(state_get_version)"
        echo ""
        echo -e "${CYAN}Recommended:${NC}"
        echo "  • Reload Hyprland config: ${BOLD}hyprctl reload${NC}"
        echo "  • Or restart Hyprland:    ${BOLD}Super+Shift+M${NC}"
        echo ""
        echo -e "${CYAN}If you have issues:${NC}"
        echo "  • Check logs:    journalctl --user -xe"
        echo "  • Rollback:      cd $REPO_ROOT && git reflog"
    fi
    
    exit 0
}

main "$@"
