#!/bin/bash
# Pull latest changes from git repository
# Handles stashing, pulling, and submodule updates

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-$HOME/.local/bin/dotfiles}"
STATE_DIR="${STATE_DIR:-$HOME/.local/state/dotfiles}"
BACKUP_DIR="$STATE_DIR/backups/git"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log_info() {
    echo -e "${GREEN}[GIT]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[GIT]${NC} $1"
}

log_error() {
    echo -e "${RED}[GIT]${NC} $1"
}

show_help() {
    cat << EOF
Usage: dotfiles-update-git [OPTIONS]

Pull latest changes from the dotfiles repository.

Options:
    -h, --help      Show this help message
    --dry-run       Show what would be done without making changes
    --force         Force pull even with local changes (creates backup)
    --no-submodules Skip submodule updates

Exit codes:
    0   Successfully updated
    1   Error occurred
    2   No updates available
EOF
}

# Get the main branch name
get_main_branch() {
    if git -C "$REPO_ROOT" show-ref --verify --quiet refs/heads/main; then
        echo "main"
    else
        echo "master"
    fi
}

# Check if there are local changes
has_local_changes() {
    ! git -C "$REPO_ROOT" diff --quiet HEAD 2>/dev/null || \
    ! git -C "$REPO_ROOT" diff --cached --quiet HEAD 2>/dev/null
}

# Get current commit hash (short)
get_current_commit() {
    git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo "unknown"
}

# Create a backup of the current state
create_backup() {
    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S)
    local backup_path="$BACKUP_DIR/$timestamp"
    
    mkdir -p "$backup_path"
    
    # Save current commit
    echo "$(get_current_commit)" > "$backup_path/commit"
    
    # Save any local changes as a patch
    if has_local_changes; then
        git -C "$REPO_ROOT" diff HEAD > "$backup_path/local_changes.patch" 2>/dev/null || true
        git -C "$REPO_ROOT" diff --cached HEAD > "$backup_path/staged_changes.patch" 2>/dev/null || true
    fi
    
    # Save list of modified files
    git -C "$REPO_ROOT" status --porcelain > "$backup_path/status" 2>/dev/null || true
    
    echo "$backup_path"
}

# Stash local changes
stash_changes() {
    if has_local_changes; then
        log_info "Stashing local changes..."
        git -C "$REPO_ROOT" stash push -m "dotfiles-update $(date +%Y%m%d_%H%M%S)" --include-untracked
        return 0
    fi
    return 1
}

# Pop stashed changes
pop_stash() {
    local stash_count
    stash_count=$(git -C "$REPO_ROOT" stash list | grep -c "dotfiles-update" || echo "0")
    
    if [[ $stash_count -gt 0 ]]; then
        log_info "Restoring stashed changes..."
        if ! git -C "$REPO_ROOT" stash pop --quiet 2>/dev/null; then
            log_warn "Could not auto-restore stashed changes (conflicts?)"
            log_warn "Run 'git stash pop' manually to restore your changes"
            return 1
        fi
    fi
    return 0
}

# Pull latest changes
pull_changes() {
    local branch
    branch=$(get_main_branch)
    
    log_info "Pulling latest changes from origin/$branch..."
    
    if ! git -C "$REPO_ROOT" pull --rebase origin "$branch"; then
        log_error "Pull failed - you may have conflicts"
        log_warn "Run 'git status' in $REPO_ROOT to see the issue"
        return 1
    fi
    
    return 0
}

# Update submodules
update_submodules() {
    if [[ -f "$REPO_ROOT/.gitmodules" ]]; then
        log_info "Updating submodules..."
        git -C "$REPO_ROOT" submodule update --init --recursive || {
            log_warn "Submodule update failed (non-critical)"
            return 0
        }
    fi
    return 0
}

# Show what changed
show_changes() {
    local old_commit="$1"
    local new_commit
    new_commit=$(get_current_commit)
    
    if [[ "$old_commit" != "$new_commit" ]]; then
        log_info "Updated from $old_commit to $new_commit"
        
        local changed_files
        changed_files=$(git -C "$REPO_ROOT" diff --name-only "$old_commit".."$new_commit" 2>/dev/null | wc -l)
        log_info "Changed files: $changed_files"
    else
        log_info "Already up to date"
    fi
}

main() {
    local dry_run=false
    local force=false
    local update_submodules_flag=true
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --force)
                force=true
                shift
                ;;
            --no-submodules)
                update_submodules_flag=false
                shift
                ;;
            *)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done
    
    # Ensure we're in a git repo
    if ! git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
        log_error "Not a git repository: $REPO_ROOT"
        exit 1
    fi
    
    # Fetch first to check for updates
    log_info "Fetching from remote..."
    git -C "$REPO_ROOT" fetch --all --tags --quiet 2>/dev/null || {
        log_error "Failed to fetch from remote"
        exit 1
    }
    
    # Check if updates available
    local branch
    branch=$(get_main_branch)
    local local_commit remote_commit
    local_commit=$(git -C "$REPO_ROOT" rev-parse HEAD)
    remote_commit=$(git -C "$REPO_ROOT" rev-parse origin/"$branch" 2>/dev/null || echo "")
    
    if [[ "$local_commit" == "$remote_commit" ]]; then
        log_info "Already up to date"
        exit 2
    fi
    
    # Dry run - just show what would happen
    if $dry_run; then
        log_info "[DRY RUN] Would update from $(get_current_commit) to ${remote_commit:0:7}"
        local commit_count
        commit_count=$(git -C "$REPO_ROOT" rev-list --count HEAD..origin/"$branch")
        log_info "[DRY RUN] $commit_count commits to pull"
        exit 0
    fi
    
    # Create backup
    mkdir -p "$BACKUP_DIR"
    local backup_path
    backup_path=$(create_backup)
    log_info "Backup created: $backup_path"
    
    # Save current commit for comparison
    local old_commit
    old_commit=$(get_current_commit)
    
    # Handle local changes
    local had_stash=false
    if has_local_changes; then
        if $force; then
            log_warn "Force mode: stashing local changes"
            stash_changes && had_stash=true
        else
            log_warn "Local changes detected"
            log_warn "Use --force to stash and continue, or commit/stash manually"
            exit 1
        fi
    fi
    
    # Pull changes
    if ! pull_changes; then
        # Try to restore stash if we had one
        if $had_stash; then
            pop_stash || true
        fi
        exit 1
    fi
    
    # Update submodules
    if $update_submodules_flag; then
        update_submodules
    fi
    
    # Restore stashed changes
    if $had_stash; then
        pop_stash || true
    fi
    
    # Show what changed
    show_changes "$old_commit"
    
    log_info "Git update complete"
    exit 0
}

main "$@"
