#!/bin/bash
# Ensure hardware-specific Hyprland config files exist
# Creates monitors.conf, nvidia.conf, asus.conf based on hardware detection
# Safe to run multiple times - only creates files if they don't exist

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-$HOME/.local/bin/dotfiles}"
HYPR_DIR="$HOME/.config/hypr"
HYPR_LOCAL="$HYPR_DIR/local"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log_info() {
    echo -e "${GREEN}[HARDWARE]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[HARDWARE]${NC} $1"
}

log_created() {
    echo -e "${CYAN}[HARDWARE]${NC} Created: $1"
}

show_help() {
    cat << EOF
Usage: dotfiles-ensure-hardware-configs [OPTIONS]

Ensure hardware-specific Hyprland config files exist.
Creates monitors.conf, nvidia.conf, and asus.conf based on detected hardware.

This script is safe to run multiple times - it only creates files if they
don't already exist, preserving any user customizations.

Options:
    -h, --help      Show this help message
    --dry-run       Show what would be created without making changes
    --force         Recreate files even if they exist (backs up existing)
    --quiet         Only output errors

Files created:
    ~/.config/hypr/monitors.conf    Monitor configuration
    ~/.config/hypr/nvidia.conf      NVIDIA GPU settings (if detected)
    ~/.config/hypr/asus.conf        ASUS laptop settings (if detected)
    ~/.config/hypr/local/*.conf     Local override placeholders
EOF
}

detect_nvidia() {
    if command -v lspci &>/dev/null; then
        if lspci | grep -qi "nvidia"; then
            return 0
        fi
    fi
    if lsmod 2>/dev/null | grep -q "^nvidia"; then
        return 0
    fi
    return 1
}

detect_asus() {
    if [[ -f /sys/class/dmi/id/sys_vendor ]]; then
        local vendor
        vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)
        if [[ "$vendor" == *"ASUS"* ]] || [[ "$vendor" == *"ASUSTeK"* ]]; then
            return 0
        fi
    fi
    if lsmod 2>/dev/null | grep -qE "asus|asusctl"; then
        return 0
    fi
    return 1
}

create_monitors_conf() {
    cat > "$HYPR_DIR/monitors.conf" << 'EOF'
# Monitor Configuration
# =====================
# Configure your monitors here.
# Run 'hyprctl monitors' to see available monitors.
#
# Format: monitor = name, resolution@rate, position, scale
# Example:
# monitor = DP-1, 1920x1080@144, 0x0, 1
# monitor = HDMI-A-1, 1920x1080@60, 1920x0, 1
#
# For automatic configuration:
monitor = , preferred, auto, 1
EOF
}

create_nvidia_conf_enabled() {
    cat > "$HYPR_DIR/nvidia.conf" << 'EOF'
# NVIDIA Configuration
# ====================
# NVIDIA GPU detected - settings enabled automatically

# Core NVIDIA environment variables
env = LIBVA_DRIVER_NAME,nvidia
env = __GLX_VENDOR_LIBRARY_NAME,nvidia
env = __GL_VRR_ALLOWED,1

# Use NVIDIA GBM backend (required for newer drivers)
env = GBM_BACKEND,nvidia-drm
env = NVD_BACKEND,direct

# Electron/Chromium apps Wayland support
env = ELECTRON_OZONE_PLATFORM_HINT,auto

# Disable atomic mode setting (can help with some display issues)
env = WLR_DRM_NO_ATOMIC,1

# Hardware cursor fix for NVIDIA
cursor:no_hardware_cursors = true
EOF
}

create_nvidia_conf_template() {
    cat > "$HYPR_DIR/nvidia.conf" << 'EOF'
# NVIDIA Configuration
# ====================
# Uncomment the following lines if you have an NVIDIA GPU:
#
# env = LIBVA_DRIVER_NAME,nvidia
# env = __GLX_VENDOR_LIBRARY_NAME,nvidia
# env = __GL_VRR_ALLOWED,1
# env = GBM_BACKEND,nvidia-drm
# env = NVD_BACKEND,direct
# env = ELECTRON_OZONE_PLATFORM_HINT,auto
# env = WLR_DRM_NO_ATOMIC,1
#
# cursor:no_hardware_cursors = true
EOF
}

create_asus_conf_enabled() {
    cat > "$HYPR_DIR/asus.conf" << 'EOF'
# ASUS-specific configuration
# ===========================
# ASUS laptop detected - hardcoded DRM device order for supergfxctl compatibility
# card0 = NVIDIA, card1 = AMD (typical ASUS ROG/TUF configuration)

env = AQ_DRM_DEVICES,/dev/dri/card0:/dev/dri/card1
EOF
}

create_asus_conf_template() {
    cat > "$HYPR_DIR/asus.conf" << 'EOF'
# ASUS-specific configuration
# ===========================
# This file is empty because no ASUS hardware was detected.
# Hyprland will auto-detect the GPU order.
# 
# If you have an ASUS laptop with supergfxctl, add:
# env = AQ_DRM_DEVICES,/dev/dri/card0:/dev/dri/card1
EOF
}

ensure_local_configs() {
    local dry_run="$1"
    local quiet="$2"
    
    local local_configs=(
        "programs.conf"
        "keybinds.conf"
        "appearance.conf"
        "autostart.conf"
        "environment.conf"
        "input.conf"
        "layout.conf"
        "windowrules.conf"
        "custom.conf"
    )
    
    mkdir -p "$HYPR_LOCAL"
    
    for conf in "${local_configs[@]}"; do
        if [[ ! -f "$HYPR_LOCAL/$conf" ]]; then
            if $dry_run; then
                [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Would create: local/$conf"
            else
                echo "# Local $conf - Add your overrides here" > "$HYPR_LOCAL/$conf"
            fi
        fi
    done
}

main() {
    local dry_run=false
    local force=false
    local quiet=false
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --force)
                force=true
                shift
                ;;
            --quiet)
                quiet=true
                shift
                ;;
            *)
                echo "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done
    
    mkdir -p "$HYPR_DIR"
    
    local has_nvidia=false
    local is_asus=false
    local created_count=0
    
    if detect_nvidia; then
        has_nvidia=true
        [[ "$quiet" == "false" ]] && log_info "NVIDIA GPU detected"
    fi
    
    if detect_asus; then
        is_asus=true
        [[ "$quiet" == "false" ]] && log_info "ASUS hardware detected"
    fi
    
    if [[ ! -f "$HYPR_DIR/monitors.conf" ]] || $force; then
        if $dry_run; then
            [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Would create: monitors.conf"
        else
            if $force && [[ -f "$HYPR_DIR/monitors.conf" ]]; then
                cp "$HYPR_DIR/monitors.conf" "$HYPR_DIR/monitors.conf.bak"
                [[ "$quiet" == "false" ]] && log_warn "Backed up existing monitors.conf"
            fi
            create_monitors_conf
            [[ "$quiet" == "false" ]] && log_created "monitors.conf (auto-detect template)"
            ((created_count++)) || true
        fi
    fi
    
    if [[ ! -f "$HYPR_DIR/nvidia.conf" ]] || $force; then
        if $dry_run; then
            if $has_nvidia; then
                [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Would create: nvidia.conf (NVIDIA enabled)"
            else
                [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Would create: nvidia.conf (template)"
            fi
        else
            if $force && [[ -f "$HYPR_DIR/nvidia.conf" ]]; then
                cp "$HYPR_DIR/nvidia.conf" "$HYPR_DIR/nvidia.conf.bak"
                [[ "$quiet" == "false" ]] && log_warn "Backed up existing nvidia.conf"
            fi
            if $has_nvidia; then
                create_nvidia_conf_enabled
                [[ "$quiet" == "false" ]] && log_created "nvidia.conf (NVIDIA settings enabled)"
            else
                create_nvidia_conf_template
                [[ "$quiet" == "false" ]] && log_created "nvidia.conf (template - no NVIDIA detected)"
            fi
            ((created_count++)) || true
        fi
    fi
    
    if [[ ! -f "$HYPR_DIR/asus.conf" ]] || $force; then
        if $dry_run; then
            if $is_asus; then
                [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Would create: asus.conf (ASUS enabled)"
            else
                [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Would create: asus.conf (empty)"
            fi
        else
            if $force && [[ -f "$HYPR_DIR/asus.conf" ]]; then
                cp "$HYPR_DIR/asus.conf" "$HYPR_DIR/asus.conf.bak"
                [[ "$quiet" == "false" ]] && log_warn "Backed up existing asus.conf"
            fi
            if $is_asus; then
                create_asus_conf_enabled
                [[ "$quiet" == "false" ]] && log_created "asus.conf (ASUS settings enabled)"
            else
                create_asus_conf_template
                [[ "$quiet" == "false" ]] && log_created "asus.conf (empty - Hyprland auto-detects GPU)"
            fi
            ((created_count++)) || true
        fi
    fi
    
    ensure_local_configs "$dry_run" "$quiet"
    
    if $dry_run; then
        [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Complete - no changes made"
    else
        if [[ $created_count -gt 0 ]]; then
            [[ "$quiet" == "false" ]] && log_info "Created $created_count hardware config file(s)"
        else
            [[ "$quiet" == "false" ]] && log_info "All hardware configs already exist"
        fi
    fi
    
    exit 0
}

main "$@"
