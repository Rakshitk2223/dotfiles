#!/bin/bash
# Sync dotfiles from repository to system
# This copies all config files, scripts, and dotfiles to their proper locations
# Safe to run anytime - preserves local customizations in local/ directories

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-$HOME/.local/bin/dotfiles}"
STATE_DIR="${STATE_DIR:-$HOME/.local/state/dotfiles}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

log_info() {
    echo -e "${GREEN}[SYNC]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[SYNC]${NC} $1"
}

log_error() {
    echo -e "${RED}[SYNC]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SYNC]${NC} $1"
}

show_help() {
    cat << EOF
Usage: dotfiles-sync [OPTIONS]

Sync dotfiles from repository to system.

This command copies all configuration files from the dotfiles repository
to their proper system locations. It's safe to run anytime and will:

  - Copy .config/ files to ~/.config/
  - Copy bin scripts to ~/.local/bin/
  - Copy .tmux.conf and .zshrc to ~/
  - Copy theme files
  - Generate hardware-specific configs if missing
  - Preserve local/ customizations (never overwritten)

Options:
    -h, --help      Show this help message
    --dry-run       Show what would be done without making changes
    --force         Force overwrite even if files are identical
    --quiet         Minimal output

This command is automatically run by 'dotfiles-update', but you can
run it manually anytime to re-sync your configuration.

Examples:
    dotfiles-sync              # Sync all dotfiles
    dotfiles-sync --dry-run    # Preview what would be synced
EOF
}

sync_config_files() {
    local dry_run="$1"
    local quiet="$2"
    
    local source_dir="$REPO_ROOT/.config"
    local dest_dir="$HOME/.config"
    
    [[ "$quiet" == "false" ]] && log_info "Syncing config files to ~/.config/..."
    
    if [[ ! -d "$source_dir" ]]; then
        log_error "Config source directory not found: $source_dir"
        return 1
    fi
    
    mkdir -p "$dest_dir"
    
    if [[ "$dry_run" == "true" ]]; then
        [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Would sync $source_dir/ to $dest_dir/"
        rsync -avhn \
            --exclude '.git' \
            --exclude '.gitmodules' \
            --exclude 'hypr/nvidia.conf' \
            --exclude 'hypr/asus.conf' \
            --exclude 'hypr/monitors.conf' \
            --exclude 'hypr/local/' \
            "$source_dir/" "$dest_dir/" 2>/dev/null | grep -E "^[^.]" | head -20 || true
    else
        rsync -avh \
            --exclude '.git' \
            --exclude '.gitmodules' \
            --exclude 'hypr/nvidia.conf' \
            --exclude 'hypr/asus.conf' \
            --exclude 'hypr/monitors.conf' \
            --exclude 'hypr/local/' \
            "$source_dir/" "$dest_dir/" > /dev/null 2>&1
    fi
    
    if [[ -d "$dest_dir/waybar/scripts" ]]; then
        find "$dest_dir/waybar/scripts" -type f -name "*.sh" -exec chmod +x {} \; 2>/dev/null || true
    fi
    
    [[ "$quiet" == "false" ]] && log_success "Config files synced"
    return 0
}

sync_bin_scripts() {
    local dry_run="$1"
    local quiet="$2"
    
    local source_dir="$REPO_ROOT/bin"
    local dest_dir="$HOME/.local/bin"
    
    [[ "$quiet" == "false" ]] && log_info "Syncing bin scripts to ~/.local/bin/..."
    
    mkdir -p "$dest_dir"
    
    local count=0
    for script in "$source_dir"/dotfiles-*; do
        [[ -f "$script" ]] || continue
        local filename
        filename=$(basename "$script")
        
        if [[ "$dry_run" == "true" ]]; then
            if [[ ! -f "$dest_dir/$filename" ]] || ! diff -q "$script" "$dest_dir/$filename" > /dev/null 2>&1; then
                [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Would copy: $filename"
                ((count++)) || true
            fi
        else
            cp "$script" "$dest_dir/"
            chmod +x "$dest_dir/$filename"
            ((count++)) || true
        fi
    done
    
    [[ "$quiet" == "false" ]] && log_success "Bin scripts synced ($count files)"
    return 0
}

sync_home_dotfiles() {
    local dry_run="$1"
    local quiet="$2"
    
    [[ "$quiet" == "false" ]] && log_info "Syncing home dotfiles..."
    
    local files=(".tmux.conf" ".zshrc")
    
    for file in "${files[@]}"; do
        local source="$REPO_ROOT/$file"
        local dest="$HOME/$file"
        
        if [[ -f "$source" ]]; then
            if [[ "$dry_run" == "true" ]]; then
                if [[ ! -f "$dest" ]] || ! diff -q "$source" "$dest" > /dev/null 2>&1; then
                    [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Would copy: $file"
                fi
            else
                cp "$source" "$dest"
            fi
        fi
    done
    
    [[ "$quiet" == "false" ]] && log_success "Home dotfiles synced"
    return 0
}

sync_default_configs() {
    local dry_run="$1"
    local quiet="$2"
    
    local source_dir="$REPO_ROOT/default"
    local dest_dir="$HOME/.local/bin/dotfiles/default"
    
    if [[ -d "$source_dir" ]]; then
        [[ "$quiet" == "false" ]] && log_info "Syncing default configs..."
        
        mkdir -p "$dest_dir"
        
        if [[ "$dry_run" == "true" ]]; then
            [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Would sync default configs"
        else
            rsync -avh "$source_dir/" "$dest_dir/" > /dev/null 2>&1
        fi
        
        [[ "$quiet" == "false" ]] && log_success "Default configs synced"
    fi
    
    return 0
}

sync_themes() {
    local dry_run="$1"
    local quiet="$2"
    
    local source_dir="$REPO_ROOT/themes"
    local dest_dir="$HOME/.local/bin/dotfiles/themes"
    
    if [[ -d "$source_dir" ]]; then
        [[ "$quiet" == "false" ]] && log_info "Syncing themes..."
        
        mkdir -p "$dest_dir"
        
        if [[ "$dry_run" == "true" ]]; then
            [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Would sync themes"
        else
            rsync -avh "$source_dir/" "$dest_dir/" > /dev/null 2>&1
        fi
        
        [[ "$quiet" == "false" ]] && log_success "Themes synced"
    fi
    
    return 0
}

sync_wallpapers() {
    local dry_run="$1"
    local quiet="$2"
    
    local source_dir="$REPO_ROOT/Wallpapers"
    local dest_dir="$HOME/.local/bin/dotfiles/Wallpapers"
    
    if [[ -d "$source_dir" ]]; then
        [[ "$quiet" == "false" ]] && log_info "Syncing wallpapers..."
        
        mkdir -p "$dest_dir"
        
        if [[ "$dry_run" == "true" ]]; then
            [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Would sync wallpapers"
        else
            rsync -avh "$source_dir/" "$dest_dir/" > /dev/null 2>&1
        fi
        
        [[ "$quiet" == "false" ]] && log_success "Wallpapers synced"
    fi
    
    return 0
}

sync_lib() {
    local dry_run="$1"
    local quiet="$2"
    
    local source_dir="$REPO_ROOT/lib"
    local dest_dir="$HOME/.local/bin/dotfiles/lib"
    
    if [[ -d "$source_dir" ]]; then
        [[ "$quiet" == "false" ]] && log_info "Syncing lib..."
        
        mkdir -p "$dest_dir"
        
        if [[ "$dry_run" == "true" ]]; then
            [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Would sync lib"
        else
            rsync -avh "$source_dir/" "$dest_dir/" > /dev/null 2>&1
        fi
        
        [[ "$quiet" == "false" ]] && log_success "Lib synced"
    fi
    
    return 0
}

ensure_hardware_configs() {
    local dry_run="$1"
    local quiet="$2"
    
    local hw_script="$REPO_ROOT/bin/dotfiles-ensure-hardware-configs"
    
    if [[ -x "$hw_script" ]]; then
        [[ "$quiet" == "false" ]] && log_info "Ensuring hardware configs..."
        
        local args=()
        [[ "$dry_run" == "true" ]] && args+=(--dry-run)
        [[ "$quiet" == "true" ]] && args+=(--quiet)
        
        "$hw_script" "${args[@]}" || {
            log_warn "Hardware config generation had issues"
        }
    fi
    
    return 0
}

ensure_local_dirs() {
    local dry_run="$1"
    local quiet="$2"
    
    [[ "$quiet" == "false" ]] && log_info "Ensuring local override directories..."
    
    local dirs=(
        "$HOME/.config/hypr/local"
        "$HOME/.config/dotfiles/zsh"
    )
    
    for dir in "${dirs[@]}"; do
        if [[ "$dry_run" == "true" ]]; then
            [[ ! -d "$dir" ]] && [[ "$quiet" == "false" ]] && log_info "[DRY RUN] Would create: $dir"
        else
            mkdir -p "$dir"
        fi
    done
    
    [[ "$quiet" == "false" ]] && log_success "Local directories ready"
    return 0
}

main() {
    local dry_run=false
    local force=false
    local quiet=false
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --force)
                force=true
                shift
                ;;
            --quiet)
                quiet=true
                shift
                ;;
            *)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done
    
    if [[ "$quiet" == "false" ]]; then
        echo ""
        echo -e "${BOLD}Syncing dotfiles...${NC}"
        echo ""
    fi
    
    sync_lib "$dry_run" "$quiet"
    sync_config_files "$dry_run" "$quiet"
    sync_bin_scripts "$dry_run" "$quiet"
    sync_home_dotfiles "$dry_run" "$quiet"
    sync_default_configs "$dry_run" "$quiet"
    sync_themes "$dry_run" "$quiet"
    sync_wallpapers "$dry_run" "$quiet"
    ensure_local_dirs "$dry_run" "$quiet"
    ensure_hardware_configs "$dry_run" "$quiet"
    
    if [[ "$quiet" == "false" ]]; then
        echo ""
        if [[ "$dry_run" == "true" ]]; then
            echo -e "${YELLOW}Dry run complete - no changes made${NC}"
        else
            echo -e "${GREEN}${BOLD}Sync complete!${NC}"
            echo ""
            echo -e "${CYAN}Tip:${NC} Reload Hyprland with: hyprctl reload"
        fi
    fi
    
    exit 0
}

main "$@"
